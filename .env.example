APP_ENV=local
LOG_LEVEL=INFO
# fake = deterministic offline backend (default, no key); openai = real provider.
LLM_BACKEND=fake
# Secret: mounted from Secret Manager in Cloud Run
OPENAI_API_KEY=
# Provider endpoint or region, e.g. a data-residency endpoint or an LLM gateway; empty = default.
LLM_BASE_URL=
CLASSIFIER_MODEL=gpt-6.1-terra
CLASSIFIER_MAX_TOKENS=1024
CLASSIFIER_REASONING_EFFORT=low
ANSWER_MODEL=gpt-6.1-terra
ANSWER_MAX_TOKENS=2048
ANSWER_REASONING_EFFORT=none
TOOLS_MODEL=gpt-6-luna
TOOLS_MAX_TOKENS=1024
TOOLS_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1
MAX_GRAPH_STEPS=12
REQUEST_DEADLINE_SECONDS=35
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PER_MINUTE=60
READY_CHECK_TIMEOUT_SECONDS=2
READY_CACHE_SECONDS=5
# Qdrant: unset QDRANT_URL indexes the bundled knowledge base in process (local dev, tests).
QDRANT_URL=
# Secret: mounted from Secret Manager in Cloud Run.
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=aeroassist
EMBEDDING_BACKEND=fastembed
DENSE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# Model cache; the Docker image bakes models into /app/models.
EMBEDDING_CACHE_DIR=
RAG_TOP_K=3
RAG_MIN_SCORE=0.2
RAG_EVIDENCE_SCORE=0.45
